__pycache__/
*.pyc
.env
*.db
*.csv
*.xlsx
test_data/
sample_templates/
*.log

# ML artifacts that MUST be versioned. The seed/sample data override the broad
# *.csv rule above; the trained model + model card under models/ are not matched
# by any ignore rule and ship with the app so it deploys and is reproducible.
!data/seed_transactions.csv
!data/sample_statement.csv
!data/sample_statement_iso.csv
!data/eval_transactions.csv

# The demo statement served by the landing page's "Try a sample statement"
# button. Synthetic and generated by scripts/make_sample_statement.py, so it is
# safe to version -- but it is listed explicitly, like the files above, rather
# than force-added, because the blanket *.csv rule is the safety net that keeps
# a real bank export from ever being committed by accident.
!viewer/public/sample-statement.csv

# Frontend (viewer/)
node_modules/
dist/
.vite/
*.local
